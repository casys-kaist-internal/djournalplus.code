# libra09 (Supermicro SYS-1029U-TR4, 2x Xeon Gold 5218, 192 GB), sourced by
# set_env.sh.  Another machine: copy this to bench/machines/<hostname -s>.env
# and edit it; run_campaign.sh's host step writes <host>.txt (machine_info.sh).

# SSDs, by model as `nvme list` prints it: the test device, and the one that
# holds the file-system images (mounted at TAU_BACKUP_ROOT)
TARGET_DISK="SAMSUNG MZPLJ3T2HBJR-00007"    # PM1735 3.2 TB
#TARGET_DISK="PM1753V8TLC"
BACKUP_DISK="PM1753V8TLC"
#BACKUP_DISK="Samsung SSD 990 PRO 4TB"

# Memory the benchmarks see, in GB (run_main.sh refuses more).  The rest is
# held from boot as unused 1 GiB huge pages; host_setup.sh checks the args.
TAU_MEM_GB=64
TAU_BOOT_ARGS="hugepagesz=1G hugepages=0:63,1:63"   # 126 of 192 GB: ~62.6 GB left
# The databases' caches at 25% of it (innodb_buffer_pool_size, shared_buffers),
# and the ZFS ARC cap a machine with TAU_MEM_GB installed gets by default
# (half) -- OpenZFS would take half of MemTotal, which counts the huge pages.
TAU_DB_CACHE_GB=$((TAU_MEM_GB / 4))
TAU_ZFS_ARC_GB=$((TAU_MEM_GB / 2))
# The dataset is the same everywhere (common.sh MAIN_TABLES, MAIN_ROWS_PER_TABLE):
# ~120 GB, 1.9x TAU_MEM_GB here.
