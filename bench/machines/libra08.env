# libra08 (Supermicro SYS-1029U-TR4, 2x Xeon Gold 5218, 192 GB -- the same
# platform as libra09), sourced by set_env.sh.
#
# Its NVMe drives (`nvme list` shows only those bound to the nvme driver):
#   86:00.0  PM1735 3.2 TB   the test device.  Usually bound to vfio-pci for the
#                            tautest VM; the bench sees it after
#                            `tools/qemu/passthrough.sh 0000:86:00.0 reset`
#   3c:00.0  980 PRO 500 GB  serial S5GYNX0T202561W, free for tests
#   3b:00.0  980 PRO 500 GB  serial S5GYNX0T202550N, ANOTHER USER'S disk
#                            (/mnt/cache-ext-workspace): never select it
# Both 980 PROs print the same model string, so they can only be told apart by
# serial.

# SSDs, by a pattern found on the disk's line of `nvme list` (set_env.sh wants
# exactly one match): the test device, and the one that holds the file-system
# images (mounted at TAU_BACKUP_ROOT)
TARGET_DISK="SAMSUNG MZPLJ3T2HBJR-00007"    # PM1735 3.2 TB
# No image store yet (an image is ~125 GB).  Candidates: the 3c 980 PRO,
# BACKUP_DISK="S5GYNX0T202561W" (~3 images; also a test disk), or the old
# system SSD's root partition /dev/sda2 (SATA, 379 GiB free in its ext4; it
# holds the 2021 system and users' old homes, so ask before using it).  sda is
# not NVMe: mount it at /mnt/tau_backup by hand and set_env.sh takes it.
BACKUP_DISK=""

# Memory the benchmarks see, in GB (run_main.sh refuses more).  The rest is
# held from boot as unused 1 GiB huge pages; host_setup.sh checks the args.
# Nodes as libra09's (93.1 + 94.5 GiB), so the same reservation: ~61.6 GB left.
TAU_MEM_GB=64
TAU_BOOT_ARGS="hugepagesz=1G hugepages=0:63,1:63"   # 126 of 192 GB
# The databases' caches at 25% of it (innodb_buffer_pool_size, shared_buffers),
# and the ZFS ARC cap a machine with TAU_MEM_GB installed gets by default
# (half) -- OpenZFS would take half of MemTotal, which counts the huge pages.
TAU_DB_CACHE_GB=$((TAU_MEM_GB / 4))
TAU_ZFS_ARC_GB=$((TAU_MEM_GB / 2))
