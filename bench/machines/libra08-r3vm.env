# libra08's R3 trial VM (2026-11-13), not a bench host: the tau kernel #401
# (/mnt/tau_backup/torner/kernels/tau-401) in qemu on libra08, 24 GiB of RAM on
# the host's 1 GiB pages, 16 vCPUs, the guest's hostname set to libra08-r3vm.
# Its two disks are emulated NVMe controllers ("QEMU NVMe Ctrl") backed by sparse
# files on libra08's PM1753 (/mnt/tau_backup/r3/vm, with the VM's launcher), so
# they are picked by serial as a bench host picks its SSDs.  For checking the
# R3 tools (bench/scripts/costs) end to end; its numbers are not paper data.
TARGET_DISK="R3TEST01"      # 64 GiB file
BACKUP_DISK="R3IMG01"       # 48 GiB file, ext4: the image store at TAU_BACKUP_ROOT

# Memory the benchmarks see: the guest's RAM (run_main.sh refuses more)
TAU_MEM_GB=24
TAU_BOOT_ARGS=""
TAU_DB_CACHE_GB=$((TAU_MEM_GB / 4))
TAU_ZFS_ARC_GB=$((TAU_MEM_GB / 2))
# Only the tau kernel boots here: the baselines run with KCHECK=1
TAU_BASE_KERNEL="6.8.0-base+"
