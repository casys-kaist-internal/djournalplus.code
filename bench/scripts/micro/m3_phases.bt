#!/usr/bin/env bpftrace
/*
 * EVAL_PLAN M3: where one process's fsync time goes (run_fio.sh M3_TRACE=1
 * attaches it to atomicw after the ramp; ends with SIGINT). Needs kernel BTF.
 * fentry/fexit (kfunc/kretfunc); kfunc:xfs needs the xfs module loaded
 * (run_fio.sh loads it; bt_for_kernel moves the probes to vmlinux where XFS is
 * built in, as on the tau kernel).
 *
 * $1  pid (atomicw)
 * $2  dev_t of the test device (major << 20 | minor), for the jbd2 tracepoint
 *
 * Per vfs_fsync_range of the process (fdatasync or fsync: @sync_ds counts the
 * fdatasyncs), its time split into exclusive phases (a nested phase's time is
 * taken out of the enclosing one; data=journal waits for the commit inside
 * the data writeback), summed over all syncs as @x[phase]:
 *   0 other  the rest of the sync
 *   1 D      file_write_and_wait_range: data writeback and its wait
 *   2 JC     jbd2_log_wait_commit: ext4, waiting for the journal commit
 *   3 LF     xfs_log_force_seq: XFS, the log force
 *   4 FL     blkdev_issue_flush: the cache flush (none sent to a write-through
 *            device)
 * On the tau kernel run_fio.sh appends m3_phases_tau.bt (its functions exist
 * only there): a tau file's fsync runs the whole tau commit in the fsync thread
 * (ext4_tau_commit / xfs_tau_commit; kworkers commit only in the background):
 *   5 TW     the tau commit outside the parts below: the write mutex and the
 *            wait for this file's earlier commit (inline waits)
 *   6 TI     tau_wait_inflight: waiting for a background commit that took the
 *            work
 *   7 CT     tau_bh_commit_transaction / tau_io_commit_transaction outside the
 *            parts below: building and publishing the transaction
 *   8 JIO    __wait_on_buffer in CT: the journal copies, descriptors and claims
 *   9 REC    __wait_on_buffer of the commit record (magic 0xc03b3998, blocktype
 *            2, big endian); a buffer done before the wait leaves no time
 *  10 DUR    ext4_tau_commit_durable / xfs_tau_commit_durable: the host commit
 *            the record names (allocating or size-moving commits and fsync(2);
 *            JC / LF nested in it count as JC / LF)
 * and @inc[phase] / @calls[phase] the inclusive time and the number of calls.
 * Each sync's phases collect per thread and count only when the sync returns,
 * and only syncs that start 2 s after BEGIN count (BEGIN fires before the
 * other probes attach), so a sync cut by the start or the end of the window
 * leaves nothing (the jbd2 commits count from then too). Phases nest to any
 * depth (a stack per thread). @sync_ns, @x and @inc in ns, one timestamp per
 * probe. The jbd2 commits of the device (all, not only the process's): request
 * delay, running, locked (waiting for handles), flushing (ordered data),
 * logging (journal blocks and the commit block) in jiffies (HZ 1000 on the base
 * kernel: ms), handles and blocks.
 */

kfunc:vmlinux:vfs_fsync_range /pid == $1 && nsecs > @gate/
{
	$now = nsecs;
	@s[tid] = $now;
	@ds[tid] = args.datasync;
	@ph[tid] = 0;
	@p0[tid] = $now;
	@lvl[tid] = 0;
}

kretfunc:vmlinux:vfs_fsync_range /pid == $1 && @s[tid]/
{
	$now = nsecs;
	@cx[tid, @ph[tid]] = @cx[tid, @ph[tid]] + $now - @p0[tid];
	@sync_n = count();
	@sync_ns = sum($now - @s[tid]);
	@sync_ds = sum(@ds[tid] != 0 ? 1 : 0);
	@sync_us_hist = hist(($now - @s[tid]) / 1000);
	@x[0] = sum(@cx[tid, 0]);
	@x[1] = sum(@cx[tid, 1]);
	@x[2] = sum(@cx[tid, 2]);
	@x[3] = sum(@cx[tid, 3]);
	@x[4] = sum(@cx[tid, 4]);
	@x[5] = sum(@cx[tid, 5]);
	@x[6] = sum(@cx[tid, 6]);
	@x[7] = sum(@cx[tid, 7]);
	@x[8] = sum(@cx[tid, 8]);
	@x[9] = sum(@cx[tid, 9]);
	@x[10] = sum(@cx[tid, 10]);
	@inc[1] = sum(@ci[tid, 1]);
	@inc[2] = sum(@ci[tid, 2]);
	@inc[3] = sum(@ci[tid, 3]);
	@inc[4] = sum(@ci[tid, 4]);
	@inc[5] = sum(@ci[tid, 5]);
	@inc[6] = sum(@ci[tid, 6]);
	@inc[7] = sum(@ci[tid, 7]);
	@inc[8] = sum(@ci[tid, 8]);
	@inc[9] = sum(@ci[tid, 9]);
	@inc[10] = sum(@ci[tid, 10]);
	@calls[1] = sum(@cn[tid, 1]);
	@calls[2] = sum(@cn[tid, 2]);
	@calls[3] = sum(@cn[tid, 3]);
	@calls[4] = sum(@cn[tid, 4]);
	@calls[5] = sum(@cn[tid, 5]);
	@calls[6] = sum(@cn[tid, 6]);
	@calls[7] = sum(@cn[tid, 7]);
	@calls[8] = sum(@cn[tid, 8]);
	@calls[9] = sum(@cn[tid, 9]);
	@calls[10] = sum(@cn[tid, 10]);
	delete(@cx[tid, 0]); delete(@cx[tid, 1]); delete(@cx[tid, 2]); delete(@cx[tid, 3]);
	delete(@cx[tid, 4]); delete(@cx[tid, 5]); delete(@cx[tid, 6]); delete(@cx[tid, 7]);
	delete(@cx[tid, 8]); delete(@cx[tid, 9]); delete(@cx[tid, 10]);
	delete(@ci[tid, 1]); delete(@ci[tid, 2]); delete(@ci[tid, 3]); delete(@ci[tid, 4]); delete(@ci[tid, 5]);
	delete(@ci[tid, 6]); delete(@ci[tid, 7]); delete(@ci[tid, 8]); delete(@ci[tid, 9]); delete(@ci[tid, 10]);
	delete(@cn[tid, 1]); delete(@cn[tid, 2]); delete(@cn[tid, 3]); delete(@cn[tid, 4]); delete(@cn[tid, 5]);
	delete(@cn[tid, 6]); delete(@cn[tid, 7]); delete(@cn[tid, 8]); delete(@cn[tid, 9]); delete(@cn[tid, 10]);
	delete(@stk[tid, 0]); delete(@stk[tid, 1]); delete(@stk[tid, 2]); delete(@stk[tid, 3]);
	delete(@stk[tid, 4]); delete(@stk[tid, 5]); delete(@stk[tid, 6]); delete(@stk[tid, 7]);
	delete(@s[tid]);
	delete(@ds[tid]);
	delete(@ph[tid]);
	delete(@p0[tid]);
	delete(@lvl[tid]);
	delete(@inct[tid]);
}

/* A phase's entry closes the enclosing phase's segment and pushes it; its exit
   closes its own segment and pops back. One pair per phase and function: this
   bpftrace cannot test the probe name, nor attach one kfunc block to functions
   with different arguments. */

kfunc:vmlinux:file_write_and_wait_range /pid == $1 && @s[tid]/
{
	$now = nsecs;
	@t0[tid, 1] = $now;
	@cx[tid, @ph[tid]] = @cx[tid, @ph[tid]] + $now - @p0[tid];
	@stk[tid, @lvl[tid]] = @ph[tid];
	@lvl[tid] = @lvl[tid] + 1;
	@ph[tid] = 1;
	@p0[tid] = $now;
}

kretfunc:vmlinux:file_write_and_wait_range /pid == $1 && @s[tid] && @lvl[tid] > 0 && @ph[tid] == 1/
{
	$now = nsecs;
	@ci[tid, 1] = @ci[tid, 1] + $now - @t0[tid, 1];
	@cn[tid, 1] = @cn[tid, 1] + 1;
	delete(@t0[tid, 1]);
	@cx[tid, 1] = @cx[tid, 1] + $now - @p0[tid];
	@lvl[tid] = @lvl[tid] - 1;
	@ph[tid] = @stk[tid, @lvl[tid]];
	delete(@stk[tid, @lvl[tid]]);
	@p0[tid] = $now;
}

kfunc:vmlinux:jbd2_log_wait_commit /pid == $1 && @s[tid]/
{
	$now = nsecs;
	@t0[tid, 2] = $now;
	@cx[tid, @ph[tid]] = @cx[tid, @ph[tid]] + $now - @p0[tid];
	@stk[tid, @lvl[tid]] = @ph[tid];
	@lvl[tid] = @lvl[tid] + 1;
	@ph[tid] = 2;
	@p0[tid] = $now;
}

kretfunc:vmlinux:jbd2_log_wait_commit /pid == $1 && @s[tid] && @lvl[tid] > 0 && @ph[tid] == 2/
{
	$now = nsecs;
	@ci[tid, 2] = @ci[tid, 2] + $now - @t0[tid, 2];
	@cn[tid, 2] = @cn[tid, 2] + 1;
	delete(@t0[tid, 2]);
	@cx[tid, 2] = @cx[tid, 2] + $now - @p0[tid];
	@lvl[tid] = @lvl[tid] - 1;
	@ph[tid] = @stk[tid, @lvl[tid]];
	delete(@stk[tid, @lvl[tid]]);
	@p0[tid] = $now;
}

kfunc:xfs:xfs_log_force_seq /pid == $1 && @s[tid]/
{
	$now = nsecs;
	@t0[tid, 3] = $now;
	@cx[tid, @ph[tid]] = @cx[tid, @ph[tid]] + $now - @p0[tid];
	@stk[tid, @lvl[tid]] = @ph[tid];
	@lvl[tid] = @lvl[tid] + 1;
	@ph[tid] = 3;
	@p0[tid] = $now;
}

kretfunc:xfs:xfs_log_force_seq /pid == $1 && @s[tid] && @lvl[tid] > 0 && @ph[tid] == 3/
{
	$now = nsecs;
	@ci[tid, 3] = @ci[tid, 3] + $now - @t0[tid, 3];
	@cn[tid, 3] = @cn[tid, 3] + 1;
	delete(@t0[tid, 3]);
	@cx[tid, 3] = @cx[tid, 3] + $now - @p0[tid];
	@lvl[tid] = @lvl[tid] - 1;
	@ph[tid] = @stk[tid, @lvl[tid]];
	delete(@stk[tid, @lvl[tid]]);
	@p0[tid] = $now;
}

kfunc:vmlinux:blkdev_issue_flush /pid == $1 && @s[tid]/
{
	$now = nsecs;
	@t0[tid, 4] = $now;
	@cx[tid, @ph[tid]] = @cx[tid, @ph[tid]] + $now - @p0[tid];
	@stk[tid, @lvl[tid]] = @ph[tid];
	@lvl[tid] = @lvl[tid] + 1;
	@ph[tid] = 4;
	@p0[tid] = $now;
}

kretfunc:vmlinux:blkdev_issue_flush /pid == $1 && @s[tid] && @lvl[tid] > 0 && @ph[tid] == 4/
{
	$now = nsecs;
	@ci[tid, 4] = @ci[tid, 4] + $now - @t0[tid, 4];
	@cn[tid, 4] = @cn[tid, 4] + 1;
	delete(@t0[tid, 4]);
	@cx[tid, 4] = @cx[tid, 4] + $now - @p0[tid];
	@lvl[tid] = @lvl[tid] - 1;
	@ph[tid] = @stk[tid, @lvl[tid]];
	delete(@stk[tid, @lvl[tid]]);
	@p0[tid] = $now;
}

tracepoint:jbd2:jbd2_run_stats /args.dev == $2 && nsecs > @gate/
{
	@jc_n = count();
	@jc_request_delay = sum(args.request_delay);
	@jc_running = sum(args.running);
	@jc_locked = sum(args.locked);
	@jc_flushing = sum(args.flushing);
	@jc_logging = sum(args.logging);
	@jc_handles = sum(args.handle_count);
	@jc_blocks = sum(args.blocks);
	@jc_blocks_logged = sum(args.blocks_logged);
}

BEGIN
{
	@gate = nsecs + 2000000000;
	printf("window_begin_ns %llu\n", @gate);
}

END
{
	printf("window_end_ns %llu\n", nsecs);
	clear(@gate);
	clear(@s);
	clear(@ds);
	clear(@ph);
	clear(@p0);
	clear(@lvl);
	clear(@stk);
	clear(@inct);
	clear(@t0);
	clear(@cx);
	clear(@ci);
	clear(@cn);
}
