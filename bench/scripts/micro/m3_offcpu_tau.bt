/*
 * EVAL_PLAN M3, CT split into on-CPU and off-CPU (final_tau/full/PLAN_m3ct_v1.1.md): appended after
 * m3_phases.bt and m3_phases_tau.bt by run_fio.sh M3_OFFCPU=1 (tau kernel, M3_TRACE=1). It reads M3's maps
 * @gate, @s and @ph and never writes them. No BEGIN or END: the program has M3's, whose END clears @gate,
 * which also stops the counting here. Report: m3_offcpu_report.py.
 *
 * Off-CPU of the traced process ($1), one interval per switch-out and switch-in. The switch-out
 * (sched_switch, in prev's context) notes the time, prev_state and the bucket. The switch-in
 * (finish_task_switch, in the context of the thread that resumes) adds the interval, so its kernel stack is
 * the sleep site. Bucket b: the M3 phase @ph (0-10) if the thread is in a counted sync (@s), else 12
 * (outside syncs: the writes, the main thread). prev_state: 0 runnable, 0x100 preempted, 1 S, 2 D (also
 * TASK_KILLABLE), 0x80 I. The wait for a CPU runs from the wakeup (sched_wakeup) to the switch-in; a runnable
 * or preempted thread waits for a CPU for all of its interval.
 *   @oc_x[b]                 stats: count and total ns of the intervals
 *   @oc_r[b]                 sum: their wait for a CPU, ns
 *   @oc_stk[b, st, kstack]   stats per sleep site and prev_state; @oc_stkr: the same keys, the wait for a CPU
 *   @oc_long[b, kstack]      stats of the intervals of 10 ms or more; @oc_lmax: their max
 *   @oc_h[b]                 log2 histogram of the intervals, us
 *   @oc_smp[b]               profile samples at 999 Hz with a thread of $1 current (the on-CPU estimate)
 *   @oc_anom                 a switch-out while one is pending (a missed switch-in): expected none
 *   @oc_nowake               a sleep (not runnable, not preempted) with no wakeup seen
 * Tau commits after the gate, any thread, and the revoke path (commit.c 732, 742 and 1003 at 547b50ba). Class
 * k: 3 the process in a counted sync (the commits in M3's CT), 2 the process outside one, 1 other threads.
 *   @rc_n[k, rv]             commits; rv 1: the transaction carries revoke blocks at entry (the test at 732)
 *   @rc_c[742, k]            filemap_fdatawrite_wbc calls in a commit with line 742's wbc (WB_SYNC_ALL,
 *                            0 to LLONG_MAX), at entry; @rc_t[742, k] stats and @rc_max[742, k] max of their
 *                            inclusive time, ns; @rc_wsite[kstack(8)] their call sites (a kfunc stack lacks
 *                            the direct caller: the frame after filemap_fdatawrite_wbc is its caller's caller)
 *   @rc_c[1003, k], @rc_t[1003, k], @rc_max[1003, k]   the same for filemap_fdatawait_range(0, LLONG_MAX) in
 *                            a commit (line 1003)
 *   @rc_nest                 a commit entered by a thread already in one: expected none
 * Counts add up at once, not per sync as in M3: a sync in flight at the end counts here and not in M3. The
 * per-thread helpers (@oc_t0, @oc_st, @oc_b, @oc_wk, @rc_in, @rc_w0, @rc_a0) keep the entries of the threads
 * still out or in a call at the end. m3_report.py reads none of these keys.
 */

tracepoint:sched:sched_switch /pid == $1 && @gate && nsecs > @gate/
{
	if (@oc_t0[tid]) { @oc_anom = count(); }
	@oc_t0[tid] = nsecs;
	@oc_st[tid] = args.prev_state;
	@oc_b[tid] = @s[tid] ? @ph[tid] : 12;
	delete(@oc_wk[tid]);
}

tracepoint:sched:sched_wakeup /@oc_t0[args.pid] && !@oc_wk[args.pid]/
{
	@oc_wk[args.pid] = nsecs;
}

kfunc:vmlinux:finish_task_switch /pid == $1 && @oc_t0[tid]/
{
	$now = nsecs;
	$d = $now - @oc_t0[tid];
	$b = @oc_b[tid];
	$st = @oc_st[tid];
	$w = @oc_wk[tid];
	$rq = $w ? $now - $w : (($st == 0 || $st == 0x100) ? $d : 0);
	if (!$w && $st != 0 && $st != 0x100) { @oc_nowake = count(); }
	$k = kstack;
	@oc_x[$b] = stats($d);
	@oc_r[$b] = sum($rq);
	@oc_stk[$b, $st, $k] = stats($d);
	@oc_stkr[$b, $st, $k] = sum($rq);
	if ($d >= 10000000) {
		@oc_long[$b, $k] = stats($d);
		@oc_lmax[$b, $k] = max($d);
	}
	@oc_h[$b] = hist($d / 1000);
	delete(@oc_t0[tid]);
	delete(@oc_st[tid]);
	delete(@oc_b[tid]);
	delete(@oc_wk[tid]);
}

profile:hz:999 /pid == $1 && @gate && nsecs > @gate/
{
	@oc_smp[@s[tid] ? @ph[tid] : 12] = count();
}

/* one pair per function: this bpftrace cannot attach one block to functions with different arguments */
kfunc:vmlinux:tau_bh_commit_transaction /@gate && nsecs > @gate/
{
	if (@rc_in[tid]) { @rc_nest = count(); }
	$k = pid == $1 ? (@s[tid] ? 3 : 2) : 1;
	@rc_in[tid] = $k;
	@rc_n[$k, (uint64)args.tcc->t->revoke_block != 0 ? 1 : 0] = count();
}

kretfunc:vmlinux:tau_bh_commit_transaction /@rc_in[tid]/
{
	delete(@rc_in[tid]);
}

kfunc:vmlinux:tau_io_commit_transaction /@gate && nsecs > @gate/
{
	if (@rc_in[tid]) { @rc_nest = count(); }
	$k = pid == $1 ? (@s[tid] ? 3 : 2) : 1;
	@rc_in[tid] = $k;
	@rc_n[$k, (uint64)args.tcc->t->revoke_block != 0 ? 1 : 0] = count();
}

kretfunc:vmlinux:tau_io_commit_transaction /@rc_in[tid]/
{
	delete(@rc_in[tid]);
}

/* commit.c:742 */
kfunc:vmlinux:filemap_fdatawrite_wbc /@rc_in[tid] && args.wbc->sync_mode == 1 && args.wbc->range_start == 0 &&
	args.wbc->range_end == 0x7fffffffffffffff/
{
	@rc_w0[tid] = nsecs;
	@rc_c[742, @rc_in[tid]] = count();
	@rc_wsite[kstack(8)] = count();
}

kretfunc:vmlinux:filemap_fdatawrite_wbc /@rc_w0[tid]/
{
	$d = nsecs - @rc_w0[tid];
	@rc_t[742, @rc_in[tid]] = stats($d);
	@rc_max[742, @rc_in[tid]] = max($d);
	delete(@rc_w0[tid]);
}

/* commit.c:1003: filemap_fdatawait() is filemap_fdatawait_range(0, LLONG_MAX) */
kfunc:vmlinux:filemap_fdatawait_range /@rc_in[tid] && args.start_byte == 0 && args.end_byte == 0x7fffffffffffffff/
{
	@rc_a0[tid] = nsecs;
	@rc_c[1003, @rc_in[tid]] = count();
}

kretfunc:vmlinux:filemap_fdatawait_range /@rc_a0[tid]/
{
	$d = nsecs - @rc_a0[tid];
	@rc_t[1003, @rc_in[tid]] = stats($d);
	@rc_max[1003, @rc_in[tid]] = max($d);
	delete(@rc_a0[tid]);
}
