/* the buffer waits of a tau commit: 9 for the commit record, 8 for the rest */
kfunc:vmlinux:__wait_on_buffer /pid == $1 && @s[tid] && @inct[tid]/
{
	$now = nsecs;
	$p = (*(uint32 *)args.bh->b_data == 0x98393bc0 && *(uint32 *)(args.bh->b_data + 4) == 0x02000000) ? 9 : 8;
	@t0[tid, $p] = $now;
	@cx[tid, @ph[tid]] = @cx[tid, @ph[tid]] + $now - @p0[tid];
	@stk[tid, @lvl[tid]] = @ph[tid];
	@lvl[tid] = @lvl[tid] + 1;
	@ph[tid] = $p;
	@p0[tid] = $now;
}

kretfunc:vmlinux:__wait_on_buffer /pid == $1 && @s[tid] && @inct[tid] && @lvl[tid] > 0 && (@ph[tid] == 8 || @ph[tid] == 9)/
{
	$now = nsecs;
	$p = @ph[tid];
	@ci[tid, $p] = @ci[tid, $p] + $now - @t0[tid, $p];
	@cn[tid, $p] = @cn[tid, $p] + 1;
	delete(@t0[tid, $p]);
	@cx[tid, $p] = @cx[tid, $p] + $now - @p0[tid];
	@lvl[tid] = @lvl[tid] - 1;
	@ph[tid] = @stk[tid, @lvl[tid]];
	delete(@stk[tid, @lvl[tid]]);
	@p0[tid] = $now;
}

