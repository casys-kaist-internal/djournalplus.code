/*
 * EVAL_PLAN M3, tau phases 5-10 (see m3_phases.bt): appended to m3_phases.bt by
 * run_fio.sh on the tau kernel, where these functions exist. Probe points from
 * libra08 (2026-11-04), checked with bpftrace -l on #1979 (new_main 4814a2e4).
 */

kfunc:vmlinux:ext4_tau_commit /pid == $1 && @s[tid]/
{
	$now = nsecs;
	@t0[tid, 5] = $now;
	@cx[tid, @ph[tid]] = @cx[tid, @ph[tid]] + $now - @p0[tid];
	@stk[tid, @lvl[tid]] = @ph[tid];
	@lvl[tid] = @lvl[tid] + 1;
	@ph[tid] = 5;
	@p0[tid] = $now;
}

kretfunc:vmlinux:ext4_tau_commit /pid == $1 && @s[tid] && @lvl[tid] > 0 && @ph[tid] == 5/
{
	$now = nsecs;
	@ci[tid, 5] = @ci[tid, 5] + $now - @t0[tid, 5];
	@cn[tid, 5] = @cn[tid, 5] + 1;
	delete(@t0[tid, 5]);
	@cx[tid, 5] = @cx[tid, 5] + $now - @p0[tid];
	@lvl[tid] = @lvl[tid] - 1;
	@ph[tid] = @stk[tid, @lvl[tid]];
	delete(@stk[tid, @lvl[tid]]);
	@p0[tid] = $now;
}

